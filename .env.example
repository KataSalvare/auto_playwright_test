# System under test. Override this value per environment when running tests.
BASE_URL=https://example.com

# Remote automation API authentication. Set a long random value before starting the API service.
AUTOMATION_API_KEY=replace-with-a-long-random-secret

# Optional: global maximum number of browser jobs running at the same time (1–10).
QUICK_TEST_MAX_CONCURRENCY=4

# Required for non-dry-run automation API jobs. Keep the real key outside Git.
NW_CALLBACK_URL=http://192.168.52.226:31004/api/nw/record/callback
NW_CALLBACK_API_KEY=replace-with-the-java-callback-secret
NW_CALLBACK_TIMEOUT_MS=10000
